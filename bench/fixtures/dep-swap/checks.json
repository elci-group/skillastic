{
  "forbidden_files": [
    "fmt.py",
    "test_report.py",
    "textutil.py"
  ],
  "patterns": [
    {
      "name": "uses-fmt-align",
      "file": "report.py",
      "regex": "fmt\\.align|from fmt import",
      "expect": true
    },
    {
      "name": "no-textutil",
      "file": "report.py",
      "regex": "textutil",
      "expect": false
    }
  ]
}
